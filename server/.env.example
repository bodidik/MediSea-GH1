# MediSea backend ortam değişkenleri (örnek)
# Gerçek değerleri .env dosyasına yaz; bu dosya sadece referanstır.

# --- Veritabanı / sunucu ---
MONGODB_URI=mongodb://127.0.0.1:27017/medknowledge
PORT=4000
HOST=0.0.0.0

# --- AI Asistan (konuya soru sor) ---
# Anthropic API anahtarı — https://console.anthropic.com adresinden alınır.
ANTHROPIC_API_KEY=
# Kullanılacak model (varsayılan: claude-sonnet-5)
AI_MODEL=claude-sonnet-5
# Yanıt başına maksimum token (varsayılan: 1024)
AI_MAX_TOKENS=1024
